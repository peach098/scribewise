# Copy to .env and fill in. Never commit .env. Placeholders only.
# Every setting is described in docs/configuration.md.

# Database (host "db" is the compose service; use localhost:5432 for local runs outside compose)
SCRIBE_DATABASE_URL=postgresql+asyncpg://scribe:scribe@db:5432/scribe

# Master key for AES-256-GCM column encryption: base64 of 32 random bytes
#   openssl rand -base64 32
SCRIBE_MASTER_KEY=change-me-base64-32-bytes
# Key rotation (docs/configuration.md): the id of SCRIBE_MASTER_KEY ("v1" until the first
# rotation), and old keys kept for decryption only as "<id>:<base64 key>,...".
# SCRIBE_MASTER_KEY_ID=v1
# SCRIBE_MASTER_KEYS_PREVIOUS=
# Refuse plaintext and pre-#59 ciphertexts once `reencrypt_all --check` reports nothing pending.
# SCRIBE_ENCRYPTION_STRICT=false

# Control bot token from @BotFather
SCRIBE_BOT_TOKEN=change-me

# Telegram API credentials from my.telegram.org
SCRIBE_TG_API_ID=0
SCRIBE_TG_API_HASH=change-me

# LLM providers: set the key of each provider your routes use (config/llm_routes.yml uses
# Anthropic). For an OpenAI-compatible API also set SCRIBE_LLM_ROUTES_PATH and confirm
# data_use_confirmed for it, see docs/self-hosting.md "Choosing models".
ANTHROPIC_API_KEY=change-me
OPENAI_API_KEY=
OPENAI_BASE_URL=
# DeepSeek (SCRIBE_LLM_ROUTES_PATH=config/llm_routes.deepseek.yml): data is stored in China and
# may be used for training unless you opt out; read docs/configuration.md before attesting with
# SCRIBE_LLM__PROVIDERS__OPENAI_COMPAT__DATA_USE_CONFIRMED=true
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Keep the bot private: the access gate is on below (SCRIBE_ACCESS_GATE=true). Put your numeric
# Telegram id into SCRIBE_OPERATOR_TELEGRAM_IDS. With the gate off Scribe refuses to start unless
# SCRIBE_OPEN_BOT=true (docs/self-hosting.md "Keep your bot private").

# Optional: defaults for NEW users (each user changes theirs in /settings; defaults shown).
# Set both delays to 0 for a quick first try. SCRIBE_WORKING_DAYS is a JSON list, 0 = Monday.
# SCRIBE_DELAY_MIN_S=120
# SCRIBE_DELAY_MAX_S=600
# SCRIBE_WORK_START=09:00
# SCRIBE_WORK_END=19:00
# SCRIBE_WORKING_DAYS=[0,1,2,3,4]
# SCRIBE_GROUPING_WINDOW_S=60         # messages from one person within this window get one draft
# SCRIBE_MESSAGE_RETENTION_DAYS=30
# SCRIBE_LLM_SPEND_RETENTION_DAYS=90
# Daily LLM budget per user, USD per UTC day (docs/configuration.md "Daily LLM budget per
# user"); 0 turns a cap off. Soft: drafts use the economy tier. Hard: drafting pauses until
# the next day. The defaults suit the DeepSeek route table (~$0.3/user/day); with the default
# Anthropic table (~$1.2/user/day) raise them, e.g. to 4 and 12.
# SCRIBE_LLM_DAILY_SOFT_CAP_USD=1.00
# SCRIBE_LLM_DAILY_HARD_CAP_USD=3.00

# Optional
SCRIBE_SCHEDULER_TICK_S=5
SCRIBE_LOG_LEVEL=INFO
# Library loggers (anthropic, openai, telethon, aiogram) stay at INFO or higher whatever
# SCRIBE_LOG_LEVEL says. true lets them log at DEBUG too: that LOGS MESSAGE CONTENT (full
# prompts, contact messages). Troubleshooting only; switch it off and rotate the logs after.
# SCRIBE_LOG_LIBRARIES_DEBUG=false
# Reading/drafting concurrency and draft review deadlines (defaults shown)
# SCRIBE_READ_CONCURRENCY=50
# SCRIBE_COMPOSE_CONCURRENCY=10
# SCRIBE_DRAFT_REMIND_AFTER_S=7200
# SCRIBE_DRAFT_EXPIRE_AFTER_S=86400
# SCRIBE_REGENERATE_MAX_PER_DRAFT=3       # 🔁 Regenerate at most this many times per draft (new messages reset it)
# SCRIBE_TEST_FAST_CLOCK=false   # true: reminder after 1 min, expiry after 2 min (manual tests)
# SCRIBE_HEALTH_HOST=0.0.0.0     # right inside the container; on bare metal use 127.0.0.1 (/healthz has no auth)
# SCRIBE_HEALTH_PORT=8080        # inside the container; with compose change SCRIBE_HEALTH_HOST_PORT instead
# SCRIBE_LLM_ROUTES_PATH=config/llm_routes.yml
# SCRIBE_LLM_PRICES_PATH=config/llm_prices.yml
# SCRIBE_PROMPTS_DIR=prompts
# Per-deployment LLM route overrides, e.g.:
# SCRIBE_LLM__COMPOSE_DRAFT__ECONOMY__MODEL=claude-sonnet-5-5

# Optional: style profile builds (defaults shown). Own messages sent to the model per profile
# (lower it for a smaller model), and the limits on group chats in the global profile's sample.
# SCRIBE_STYLE_IMPORT_MONTHS=6
# SCRIBE_MAX_CONTACT_PROFILES=20
# SCRIBE_MIN_STYLE_SAMPLES=50
# SCRIBE_PROFILE_EXAMPLES_CONTACT=20
# SCRIBE_PROFILE_EXAMPLES_GLOBAL=50
# SCRIBE_PROFILE_MAX_SAMPLES=400
# SCRIBE_PROFILE_GROUP_SAMPLES_PER_CHAT=40
# SCRIBE_PROFILE_GROUP_SAMPLES_SHARE=0.3
# Work account mode (specs/008): recent private chats the style import also reads while it is on.
# SCRIBE_WORK_ACCOUNT_IMPORT_MAX_CHATS=50

# Optional: Telegram login (defaults shown)
# SCRIBE_TG_QR_MAX_CODES=5
# SCRIBE_TG_LOGIN_PASSWORD_TIMEOUT_S=600
# SCRIBE_TG_QR_SAME_DEVICE_LINK=false   # enable only after checking it works on iOS and Android
# SCRIBE_TG_DEVICE_MODEL=Scribe Agent
# SCRIBE_TG_SYSTEM_VERSION=server

# Optional: ✏️ Edit of a short draft. auto: fill the input field when inline mode is on in
# BotFather (/setinline), else copy the draft; inline / copy force one of them.
# SCRIBE_EDIT_PREFILL=auto

# Who may use the bot (docs/access-gate.md). Required choice: with the gate off Scribe refuses
# to start unless SCRIBE_OPEN_BOT=true, because anyone who finds the bot could connect their
# account and use your LLM key. Personal install: the gate on with your own Telegram id.
# Add existing users with `python -m scribe.admin beta add <id>` BEFORE turning the gate on.
# SCRIBE_OPERATOR_TELEGRAM_IDS: comma-separated numeric Telegram ids, e.g. 900000001,900000002
SCRIBE_ACCESS_GATE=true
SCRIBE_OPERATOR_TELEGRAM_IDS=
# SCRIBE_OPEN_BOT=false                # true: the gate off on purpose, every sender is served
# SCRIBE_SUBSCRIPTION_CONTACT=         # shown with the "Subscription" button and in renewal reminders; empty: left out
# SCRIBE_ACCESS_REFUSAL_COOLDOWN_S=3600
# Optional: Jira task source (defaults shown; specs/003-jira-commitments)
# SCRIBE_JIRA_DC_MIN_VERSION=10.3          # oldest self-hosted Jira accepted; raise to 11.3 after 2026-12-05
# SCRIBE_JIRA_ALLOWED_PRIVATE_HOSTS=       # comma-separated hosts/CIDRs a self-hosted Jira may use on a private network
# SCRIBE_JIRA_ALLOWED_PORTS=443,8443       # ports a new Jira address may use (the full list); others are refused
# SCRIBE_JIRA_SYNC_INTERVAL_S=300          # how often the user's Jira comments are checked
# SCRIBE_JIRA_SYNC_CONCURRENCY=5
# SCRIBE_JIRA_LOOKBACK_DAYS=30
# SCRIBE_JIRA_FIRST_SCAN_MAX_ISSUES=1000

# Optional: skipping messages that need no reply (specs/004, defaults shown)
# SCRIBE_SKIP_MIN_CONFIDENCE=0.8
# SCRIBE_SKIP_CANDIDATE_MAX_CHARS=2000
# SCRIBE_SKIP_CONTEXT_MESSAGES=8
# SCRIBE_SKIP_HABIT_WINDOW=5
# SCRIBE_SKIP_HABIT_MIN_REPLIES=3
# SCRIBE_SKIP_HABIT_REPLY_WINDOW_MIN=30
# SCRIBE_SKIPPED_LIST_DAYS=7
# Optional: search over earlier conversations while drafting (defaults shown; specs/004-conversation-search)
# SCRIBE_EARLIER_SEARCH_ENABLED=true       # operator switch; users also have a toggle in /settings
# SCRIBE_EARLIER_SEARCH_TIMEOUT_S=6        # seconds for the Telegram search step (1-9); search + ranking stay under 10 s
# Optional: "what's new" messages after an update (defaults shown; specs/011-release-notes, docs/release-notes.md)
# SCRIBE_RELEASE_NOTES_AUTO=true           # false: nothing is sent at startup; use `python -m scribe.admin release-notes send`
# SCRIBE_RELEASE_NOTES_RATE_PER_S=10       # messages a second for announcements (1-25)
# SCRIBE_RELEASE_NOTES_MAX_ATTEMPTS=5      # network/server errors before a delivery is failed
# SCRIBE_RELEASE_NOTES_DIR=release-notes

# Optional: host ports published by docker compose (change if already in use)
SCRIBE_DB_HOST_PORT=5432
SCRIBE_HEALTH_HOST_PORT=8080
